// ArrayList<V>: every method, on int, Str, class, tuple and optional elements.
import ::collections;

class Point {
  x: int;
  fn __init__(x: int) { self.x = x; }
  fn toString() -> Str { return "P" + Str(self.x); }
  fn equals(o: Obj) -> bool {
    match o {
      p: Point { return p.x == self.x; }
      _        { return False; }
    }
  }
}

fn section(name: Str) { println("== " + name); }

fn main() -> int {
  section("push / get / set / len");
  l = collections::ArrayList<int>();
  println("empty: " + Str(l.isEmpty()) + " len=" + Str(l.len()) + " " + collections::listToString(l));
  l.push(10);
  l.push(20);
  l.push(30);
  println("len=" + Str(l.len()) + " empty=" + Str(l.isEmpty()) + " get(1)=" + Str(l.get(1)));
  l.set(1, 25);
  println(collections::listToString(l) + " joined: " + collections::join(l, "-"));

  section("insert / removeAt / pop");
  l.insert(0, 5);
  l.insert(2, 15);
  l.insert(l.len(), 40);
  println(collections::listToString(l));
  println("removeAt(0)=" + Str(l.removeAt(0)) + " removeAt(2)=" + Str(l.removeAt(2)) + " -> " + collections::listToString(l));
  println("pop=" + Str(l.pop()) + " -> " + collections::listToString(l));
  println("removeAt(last)=" + Str(l.removeAt(l.len() - 1)) + " -> " + collections::listToString(l));

  section("indexOf / lastIndexOf / contains / remove");
  l.pushAll([30, 10, 30]);
  println(collections::listToString(l));
  println("indexOf 30: " + Str(l.indexOf(30)) + " lastIndexOf 30: " + Str(l.lastIndexOf(30)) + " indexOf 7: " + Str(l.indexOf(7)));
  println("contains 10: " + Str(l.contains(10)) + " contains 7: " + Str(l.contains(7)));
  println("remove 30: " + Str(l.remove(30)) + " -> " + collections::listToString(l));
  println("remove 7: " + Str(l.remove(7)) + " -> " + collections::listToString(l));

  section("swap / reverse / slice / copy / toArray");
  l.swap(0, l.len() - 1);
  println(collections::listToString(l));
  l.reverse();
  println(collections::listToString(l));
  println("slice(1,3): " + collections::listToString(l.slice(1, 3)) + " slice(2,2): " + collections::listToString(l.slice(2, 2)));
  cp = l.copy();
  cp.push(99);
  println("copy: " + collections::listToString(cp) + " original: " + collections::listToString(l));
  arr: int[] = l.toArray();
  arr.push(77);
  println("toArray len=" + Str(arr.len()) + " original len=" + Str(l.len()));

  section("equals / clear");
  e1 = collections::ArrayList<int>();
  e1.pushAll([1, 2, 3]);
  e2 = collections::ArrayList<int>();
  e2.pushAll([1, 2, 3]);
  e3 = collections::ArrayList<int>();
  e3.pushAll([3, 2, 1]);
  println("equal: " + Str(e1 == e2) + " order matters: " + Str(e1 == e3) + " " + Str(e1 != e3));
  e2.push(4);
  println("length differs: " + Str(e1 == e2));
  o: Obj = [1, 2, 3];
  println("vs array: " + Str(e1.equals(o)));
  e1.clear();
  println("cleared: " + collections::listToString(e1) + " len=" + Str(e1.len()) + " equal to empty: " + Str(e1 == collections::ArrayList<int>()));

  section("Str elements");
  ws = collections::ArrayList<Str>();
  ws.pushAll(["b", "a", "c"]);
  ws.insert(1, "z");
  println(collections::listToString(ws) + " " + collections::join(ws, ", "));
  println("indexOf a: " + Str(ws.indexOf("a")) + " remove z: " + Str(ws.remove("z")) + " -> " + collections::join(ws, ""));

  section("class elements");
  ps = collections::ArrayList<Point>();
  ps.push(Point(1));
  ps.push(Point(2));
  println(collections::listToString(ps) + " indexOf P2: " + Str(ps.indexOf(Point(2))) + " contains P3: " + Str(ps.contains(Point(3))));
  println("get(0).x=" + Str(ps.get(0).x));

  section("tuple elements");
  ts = collections::ArrayList<(int, Str)>();
  ts.push((1, "one"));
  ts.push((2, "two"));
  ts.insert(1, (3, "three"));
  println("len=" + Str(ts.len()) + " indexOf (2,two): " + Str(ts.indexOf((2, "two"))) + " contains (9,x): " + Str(ts.contains((9, "x"))));
  n, name = ts.removeAt(1);
  println("removed " + Str(n) + " " + name + " get(1)=" + ts.get(1).toString());

  section("optional elements");
  os = collections::ArrayList<int?>();
  os.push(None);
  os.push(5);
  os.push(None);
  none: int? = None;
  println("len=" + Str(os.len()) + " indexOf 5: " + Str(os.indexOf(5)) + " lastIndexOf None: " + Str(os.lastIndexOf(none)));
  match os.get(1) {
    v: int { println("get(1)=" + Str(v)); }
    None   { println("get(1)=None"); }
  }

  section("list of lists");
  ll = collections::ArrayList<collections::ArrayList<int>>();
  ll.push(collections::ArrayList<int>());
  ll.get(0).push(1);
  ll.get(0).push(2);
  println("inner: " + collections::listToString(ll.get(0)) + " outer len=" + Str(ll.len()));

  section("growth");
  big = collections::ArrayList<int>();
  i: int = 0;
  while (i < 1000) {
    big.push(i);
    i = i + 1;
  }
  big.insert(0, -1);
  println("len=" + Str(big.len()) + " first=" + Str(big.get(0)) + " last=" + Str(big.get(big.len() - 1)) + " mid=" + Str(big.get(500)));
  while (big.len() > 3) { big.pop(); }
  println(collections::listToString(big));
  return 0;
}
