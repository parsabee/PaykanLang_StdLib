// Stress: thousands of insertions, rehash growth, removal patterns, the
// determinism of the iteration order under churn, linked-list traffic at both
// ends, and the array helpers.
import ::collections;

fn section(name: Str) { println("== " + name); }

// A cheap order-sensitive checksum of an int sequence.
fn checksum(xs: int[]) -> int {
  h: int = 17;
  i: int = 0;
  while (i < xs.len()) {
    h = h * 31 + xs[i];
    i = i + 1;
  }
  return h;
}

fn main() -> int {
  section("10000 int keys");
  m = collections::HashMap<int, int>();
  i: int = 0;
  while (i < 10000) {
    m.put(i * 3, i);
    i = i + 1;
  }
  println("len=" + Str(m.len()));
  missing: int = 0;
  wrong: int = 0;
  i = 0;
  while (i < 10000) {
    match m.get(i * 3) {
      v: int { if (v != i) { wrong = wrong + 1; } }
      None   { missing = missing + 1; }
    }
    if (m.contains(i * 3 + 1)) { wrong = wrong + 1; }
    i = i + 1;
  }
  println("missing=" + Str(missing) + " wrong=" + Str(wrong));

  section("remove every other key, then the rest");
  i = 0;
  while (i < 10000) {
    if (!m.remove(i * 3)) { wrong = wrong + 1; }
    i = i + 2;
  }
  println("len=" + Str(m.len()) + " wrong=" + Str(wrong) + " keys=" + Str(m.keys().len()));
  ks: int[] = m.keys();
  println("first=" + Str(ks[0]) + " second=" + Str(ks[1]) + " last=" + Str(ks[ks.len() - 1]) + " checksum=" + Str(checksum(ks)));
  i = 1;
  while (i < 10000) {
    if (!m.remove(i * 3)) { wrong = wrong + 1; }
    i = i + 2;
  }
  println("len=" + Str(m.len()) + " wrong=" + Str(wrong) + " empty=" + Str(m.isEmpty()) + " " + m.toString());

  section("churn: put/remove the same keys many times");
  i = 0;
  while (i < 20000) {
    m.put(i % 50, i);
    m.remove((i + 25) % 50);
    i = i + 1;
  }
  println("len=" + Str(m.len()) + " keys=" + Str(m.keys().len()) + " checksum=" + Str(checksum(m.keys())));

  section("insertion order survives growth and compaction");
  o = collections::HashMap<int, int>();
  i = 0;
  while (i < 3000) {
    o.put(2999 - i, i);
    i = i + 1;
  }
  i = 0;
  while (i < 3000) {
    if (i % 3 != 0) { o.remove(2999 - i); }
    i = i + 1;
  }
  o.put(2999 - 1, -1);
  oks: int[] = o.keys();
  inOrder: bool = True;
  i = 1;
  while (i < oks.len() - 1) {
    if (oks[i] >= oks[i - 1]) { inOrder = False; }
    i = i + 1;
  }
  println("len=" + Str(o.len()) + " descending=" + Str(inOrder) + " last=" + Str(oks[oks.len() - 1]) + " checksum=" + Str(checksum(oks)));

  section("5000 Str keys");
  sm = collections::HashMap<Str, int>();
  i = 0;
  while (i < 5000) {
    sm.put("key-" + Str(i), i);
    i = i + 1;
  }
  bad: int = 0;
  i = 0;
  while (i < 5000) {
    if (sm.getOr("key-" + Str(i), -1) != i) { bad = bad + 1; }
    i = i + 1;
  }
  println("len=" + Str(sm.len()) + " bad=" + Str(bad) + " contains key-4999: " + Str(sm.contains("key-4999")) + " contains key-5000: " + Str(sm.contains("key-5000")));

  section("sets of 5000");
  s = collections::HashSet<int>();
  i = 0;
  while (i < 5000) {
    s.add(i);
    s.add(i);
    i = i + 1;
  }
  t = collections::HashSet<int>();
  i = 2500;
  while (i < 7500) {
    t.add(i);
    i = i + 1;
  }
  println("len=" + Str(s.len()) + " union=" + Str(s.union(t).len()) + " intersection=" + Str(s.intersection(t).len()) + " difference=" + Str(s.difference(t).len()));
  println("checksum=" + Str(checksum(s.values())));

  section("linked list: 50000 pushes and pops at both ends");
  dq = collections::LinkedList<int>();
  i = 0;
  while (i < 50000) {
    if (i % 2 == 0) { dq.pushBack(i); } else { dq.pushFront(i); }
    i = i + 1;
  }
  println("len=" + Str(dq.len()) + " front=" + Str(dq.front()) + " back=" + Str(dq.back()));
  sum: int = 0;
  i = 0;
  while (i < 20000) {
    sum = sum + dq.popFront() - dq.popBack();
    i = i + 1;
  }
  println("len=" + Str(dq.len()) + " sum=" + Str(sum) + " front=" + Str(dq.front()) + " back=" + Str(dq.back()));
  removed: int = 0;
  i = 0;
  while (i < 10000) {
    if (dq.remove(i * 4)) { removed = removed + 1; }
    i = i + 1;
  }
  println("removed=" + Str(removed) + " len=" + Str(dq.len()) + " checksum=" + Str(checksum(dq.toArray())));
  dq.reverse();
  println("reversed checksum=" + Str(checksum(dq.toArray())) + " front=" + Str(dq.front()) + " back=" + Str(dq.back()));
  // Queue churn: the dense node array must not grow with the traffic.
  qq = collections::LinkedList<int>();
  i = 0;
  while (i < 100000) {
    qq.enqueue(i);
    if (i % 3 != 0) { qq.dequeue(); }
    i = i + 1;
  }
  println("queue len=" + Str(qq.len()) + " front=" + Str(qq.front()) + " back=" + Str(qq.back()) + " checksum=" + Str(checksum(qq.toArray())));

  section("join / listToString over arrays");
  xs: int[] = [];
  i = 0;
  while (i < 5000) {
    xs.push(i);
    i = i + 1;
  }
  joined: Str = collections::join(xs, ",");
  println("joined len=" + Str(joined.len()) + " listToString len=" + Str(collections::listToString(xs).len()));
  empty: Str[] = [];
  println("empty: [" + collections::join(empty, ", ") + "] " + collections::listToString(empty));
  println(collections::join(["a", "b", "c"], "-") + " " + collections::listToString(["a", "b"]) + " " + collections::listToString([1.5, 2.0]) + " " + collections::listToString(['x']) + " " + collections::listToString([True, False]));
  return 0;
}
