// Count how often each word occurs in a text and print the words by
// frequency: a HashMap<Str, int> for the counts, an ArrayList<Str> for the
// ordering. Works once PaykanLang exports generics across modules (#160);
// until then scripts/run_tests.py inlines the module for you.
import ::collections;

// The words of `text`, split on spaces (there is no ::strings module yet).
fn words(text: Str) -> collections::ArrayList<Str> {
  out = collections::ArrayList<Str>();
  cur: Str = "";
  i: int = 0;
  while (i < text.len()) {
    if (text[i] == ' ') {
      if (cur.len() > 0) { out.push(cur); }
      cur = "";
    } else {
      cur = cur + Str(text[i]);
    }
    i = i + 1;
  }
  if (cur.len() > 0) { out.push(cur); }
  return out;
}

fn main() -> int {
  text: Str = "the cat saw the dog and the dog saw the bird and the bird flew";
  ws = words(text);
  counts = collections::HashMap<Str, int>();
  i: int = 0;
  while (i < ws.len()) {
    w: Str = ws.get(i);
    counts.put(w, counts.getOr(w, 0) + 1);
    i = i + 1;
  }

  // Insertion sort of the distinct words by falling count; keys() lists
  // them in first-seen order, which the stable sort preserves among ties.
  order = collections::ArrayList<Str>();
  order.pushAll(counts.keys());
  i = 1;
  while (i < order.len()) {
    j: int = i;
    while (j > 0 && counts.getOr(order.get(j - 1), 0) < counts.getOr(order.get(j), 0)) {
      order.swap(j - 1, j);
      j = j - 1;
    }
    i = i + 1;
  }

  println(Str(ws.len()) + " words, " + Str(counts.len()) + " distinct");
  i = 0;
  while (i < order.len()) {
    w: Str = order.get(i);
    println(w + ": " + Str(counts.getOr(w, 0)));
    i = i + 1;
  }
  return 0;
}
