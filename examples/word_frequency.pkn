// Count how often each word occurs in a text and print the words by
// frequency: a HashMap<Str, int> for the counts, a Str[] for the ordering.
// Works once PaykanLang exports generics across modules (#160); until then
// scripts/run_tests.py inlines the module for you.
import ::collections;

// The words of `text`, split on spaces (there is no ::strings module yet).
fn words(text: Str) -> Str[] {
  out: Str[] = [];
  cur: Str = "";
  i: int = 0;
  while (i < text.len()) {
    if (text[i] == ' ') {
      if (cur.len() > 0) { out.push(cur); }
      cur = "";
    } else {
      cur = cur + Str(text[i]);
    }
    i = i + 1;
  }
  if (cur.len() > 0) { out.push(cur); }
  return out;
}

fn main() -> int {
  text: Str = "the cat saw the dog and the dog saw the bird and the bird flew";
  ws: Str[] = words(text);
  counts = collections::HashMap<Str, int>();
  i: int = 0;
  while (i < ws.len()) {
    counts.put(ws[i], counts.getOr(ws[i], 0) + 1);
    i = i + 1;
  }

  // Insertion sort of the distinct words by falling count; keys() lists
  // them in first-seen order, which the stable sort preserves among ties.
  order: Str[] = counts.keys();
  i = 1;
  while (i < order.len()) {
    j: int = i;
    while (j > 0 && counts.getOr(order[j - 1], 0) < counts.getOr(order[j], 0)) {
      t: Str = order[j - 1];
      order[j - 1] = order[j];
      order[j] = t;
      j = j - 1;
    }
    i = i + 1;
  }

  println(Str(ws.len()) + " words, " + Str(counts.len()) + " distinct: " + collections::listToString(order));
  i = 0;
  while (i < order.len()) {
    println(order[i] + ": " + Str(counts.getOr(order[i], 0)));
    i = i + 1;
  }
  return 0;
}
