// Breadth-first search over a small graph: a HashMap<Str, Str[]> of
// adjacency lists, a HashSet<Str> of visited nodes and a LinkedList<Str> as
// the queue.
// Works once PaykanLang exports generics across modules (#160); until then
// scripts/run_tests.py inlines the module for you.
import ::collections;

class Graph {
  edges: collections::HashMap<Str, Str[]>;

  fn __init__() { self.edges = collections::HashMap<Str, Str[]>(); }

  // Add an undirected edge between `a` and `b`.
  fn connect(a: Str, b: Str) {
    self.neighbours(a).push(b);
    self.neighbours(b).push(a);
  }

  // The adjacency list of `n`, created on first use (arrays are shared, so
  // pushing onto the returned array updates the map's entry).
  fn neighbours(n: Str) -> Str[] {
    match self.edges.get(n) {
      l: Str[] { return l; }
      None {
        l: Str[] = [];
        self.edges.put(n, l);
        return l;
      }
    }
  }

  // The nodes reachable from `start`, in breadth-first order.
  fn bfs(start: Str) -> Str[] {
    seen = collections::HashSet<Str>();
    queue = collections::LinkedList<Str>();
    order: Str[] = [];
    seen.add(start);
    queue.enqueue(start);
    while (!queue.isEmpty()) {
      n: Str = queue.dequeue();
      order.push(n);
      next: Str[] = self.neighbours(n);
      i: int = 0;
      while (i < next.len()) {
        if (seen.add(next[i])) { queue.enqueue(next[i]); }
        i = i + 1;
      }
    }
    return order;
  }
}

fn main() -> int {
  g = Graph();
  g.connect("a", "b");
  g.connect("a", "c");
  g.connect("b", "d");
  g.connect("c", "d");
  g.connect("d", "e");
  g.connect("x", "y");

  println("from a: " + collections::join(g.bfs("a"), " "));
  println("from e: " + collections::join(g.bfs("e"), " "));
  println("from x: " + collections::join(g.bfs("x"), " "));

  all = collections::HashSet<Str>();
  all.addAll(g.edges.keys());
  reachable = collections::HashSet<Str>();
  reachable.addAll(g.bfs("a"));
  println("unreachable from a: " + all.difference(reachable).toString());
  return 0;
}
